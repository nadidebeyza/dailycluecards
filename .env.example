# Daily Clue Cards - Environment Variables
# Copy this file to .env and fill in your values

# Google AI (Gemini) API Key
# Get it from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Instagram API Configuration
# Get these from Meta Developer Portal / Meta Business Suite
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# Optional: Facebook Page ID (if using Facebook Login tokens)
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# Branding
BRAND_NAME=dailycluecards
WATERMARK_TEXT=@dailycluecards

# Optional: Override default Gemini model
# GEMINI_MODEL=gemini-2.0-flash
